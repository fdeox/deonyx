{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deonyx",
  "version": "0.1.0",
  "identifier": "com.fdeox.deonyx",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "fdeox",
    "copyright": "Copyright (C) 2026 fdeox",
    "shortDescription": "Dark mode for any Windows app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
