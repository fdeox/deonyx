{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deonyx",
  "version": "0.1.0",
  "identifier": "com.fdeox.deonyx",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "fdeox",
    "copyright": "Copyright (C) 2026 fdeox",
    "shortDescription": "Dark mode for any Windows app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": [
          "English",
          "Turkish",
          "German",
          "French",
          "Spanish",
          "Italian",
          "PortugueseBR",
          "Dutch",
          "Russian",
          "Ukrainian",
          "Japanese",
          "Korean",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNzU5NTYwNEEyMjkzMjMKUldRamt5SktZSlYxWXhpbU9KMVZkc0pwUHRCUUVjR1FtWklLWFQ0TWNzZFdaRUQ1RlVibHkybnYK",
      "endpoints": [
        "https://github.com/fdeox/deonyx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
